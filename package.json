{
  "name": "vaultx",
  "version": "0.1.0",
  "private": true,
  "description": "VaultX multi-chain Web3 wallet foundation",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.18.0 <23",
    "pnpm": ">=9.15.5 <10"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @vaultx/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "lint-staged": {
    "*.{css,html,json,md,yml,yaml}": "prettier --write",
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@vaultx/config": "workspace:*",
    "eslint": "^9.19.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.0",
    "puppeteer": "^25.3.0"
  },
  "dependencies": {
    "lucide-react": "^1.24.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "^6.27.0",
      "elliptic": "^6.6.1"
    }
  }
}
